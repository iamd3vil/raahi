[Unit]
Description=Raahi reverse proxy
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=sarat
Group=sarat
WorkingDirectory=/home/sarat/code/projects/personal/raahi
ExecStart=/home/sarat/code/projects/personal/raahi/target/release/raahi --db sqlite:///home/sarat/code/projects/personal/raahi/raahi.db --http-addr 0.0.0.0:80 --https-addr 0.0.0.0:443 --admin-addr 0.0.0.0:19080 --ui-dir /home/sarat/code/projects/personal/raahi/ui/build
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
